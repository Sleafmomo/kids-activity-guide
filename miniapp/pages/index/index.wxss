/* ========== 筛选区 ========== */
.filters {
  background: #ffffff;
  border-bottom: 1rpx solid #e3e8ee;
  padding: 24rpx 32rpx 20rpx;
}
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 24rpx;
}
.filter-label { font-size: 27rpx; color: #5b6b7a; }
.age-row { gap: 20rpx; }
.age-label { font-weight: 600; font-size: 32rpx; }
.age-value { font-weight: 700; color: #0d7377; font-size: 38rpx; min-width: 100rpx; }
.age-step {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  border: 1rpx solid #e3e8ee; background: #fff; color: #0d7377;
  font-size: 34rpx; line-height: 56rpx; text-align: center; flex-shrink: 0;
}
.age-slider { flex: 1; min-width: 300rpx; margin: 0; }
.search-row { margin-bottom: 24rpx; }
.search {
  flex: 1; width: 100%;
  padding: 18rpx 26rpx;
  border: 1rpx solid #e3e8ee; border-radius: 20rpx;
  font-size: 30rpx; background: #fff; box-sizing: border-box;
}
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.chip {
  border: 1rpx solid #e3e8ee; background: #fff; color: #1f2933;
  padding: 10rpx 28rpx; border-radius: 999rpx; font-size: 28rpx;
}
.chip.active { background: #0d7377; border-color: #0d7377; color: #fff; }
.more-toggle { font-size: 28rpx; color: #5b6b7a; padding: 8rpx 0; margin-bottom: 16rpx; }
.selects { gap: 24rpx; }
.pick-label { font-size: 28rpx; color: #5b6b7a; }
.pick-value { color: #1f2933; font-weight: 600; }
.pick-label.check.on { color: #0d7377; font-weight: 600; }
.reset {
  margin-left: auto; border: 1rpx solid #e3e8ee; background: #fff;
  color: #5b6b7a; border-radius: 16rpx; padding: 10rpx 28rpx; font-size: 27rpx;
}
.ghost-btn {
  border: 1rpx solid #e3e8ee; background: #fff; border-radius: 999rpx;
  padding: 10rpx 24rpx; font-size: 27rpx; color: #0d7377;
}

/* ========== 结果区 ========== */
.main { padding: 32rpx; }
.result-count { font-size: 29rpx; color: #5b6b7a; margin-bottom: 28rpx; }
.group { margin-bottom: 48rpx; }
.group-title {
  font-size: 36rpx; font-weight: 700;
  padding-bottom: 16rpx; border-bottom: 4rpx solid #1f2933; margin-bottom: 28rpx;
}
.group-title.ok { border-color: #15803d; color: #15803d; }
.group-title.soon { border-color: #b45309; color: #b45309; }
.group-title.dim { border-color: #e3e8ee; color: #5b6b7a; }
.group-title.neg { border-color: #b91c1c; color: #b91c1c; }
.group-title.plan { border-color: #0d7377; color: #0d7377; }
.group-hint { font-size: 27rpx; color: #5b6b7a; margin: -8rpx 0 24rpx; }
.neg-hint { color: #b91c1c; opacity: .85; }
.cards { display: flex; flex-direction: column; gap: 24rpx; }

/* ========== 卡片 ========== */
.card {
  background: #fff; border: 1rpx solid #e3e8ee; border-radius: 28rpx;
  padding: 28rpx 32rpx;
}
.card.upcoming, .card.passed-card { opacity: .78; }
.card.neg-card { border-color: #f3caca; background: #fffafa; }
.card-top { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.card-name { font-size: 35rpx; font-weight: 700; }
.cat-tag {
  font-size: 25rpx; color: #0d7377; background: #e6f4f3;
  border-radius: 12rpx; padding: 3rpx 16rpx; white-space: nowrap;
}
.badge {
  font-size: 25rpx; border-radius: 999rpx; padding: 3rpx 18rpx;
  white-space: nowrap; font-weight: 600;
}
.badge.encouraged { color: #15803d; background: #e8f7ee; }
.badge.caution { color: #b45309; background: #fdf3e0; }
.badge.negative { color: #b91c1c; background: #fdecec; }
.card-age { font-size: 28rpx; color: #5b6b7a; margin: 12rpx 0 8rpx; }
.age-b { color: #1f2933; font-weight: 700; }
.ab-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 12rpx 0; }
.ab-tag {
  font-size: 26rpx; background: #eef2f6; border-radius: 12rpx;
  padding: 3rpx 16rpx; color: #3d4d5c;
}
.ab-tag.main { background: rgba(13,115,119,.09); color: #0d7377; font-weight: 600; }
.card-summary { font-size: 29rpx; color: #33424f; margin-top: 8rpx; }
.card-actions { display: flex; gap: 28rpx; margin-top: 16rpx; }
.card-toggle { font-size: 28rpx; color: #0d7377; }
.card-detail { margin-top: 20rpx; border-top: 1rpx dashed #e3e8ee; padding-top: 20rpx; font-size: 28rpx; }
.card-detail .row { display: flex; gap: 4rpx; margin-bottom: 16rpx; }
.card-detail .k { color: #5b6b7a; flex-shrink: 0; margin-right: 12rpx; }
.card-detail .v { flex: 1; }
.row.warnline {
  display: block; color: #1f2933;
  background: #fdecec; border-left: 6rpx solid #b91c1c;
  border-radius: 0 16rpx 16rpx 0; padding: 14rpx 20rpx; font-size: 28rpx;
}
.row.warnline .k { color: #b91c1c; font-weight: 600; margin-right: 4rpx; }
.quote {
  display: block; margin: 8rpx 0 8rpx 24rpx; padding: 12rpx 20rpx;
  border-left: 6rpx solid #e6f4f3; background: #f8fafa;
  border-radius: 0 16rpx 16rpx 0; font-size: 27rpx; color: #33505a; width: 100%;
  box-sizing: border-box;
}
.quote-src { display: block; margin-top: 4rpx; font-size: 24rpx; color: #5b6b7a; }
.src-row { align-items: flex-start; }
.tier {
  font-size: 25rpx; border-radius: 12rpx; padding: 1rpx 14rpx;
  margin-right: 12rpx; white-space: nowrap; flex-shrink: 0;
}
.tier.official { color: #1d4ed8; background: #e5edff; }
.tier.authority { color: #047857; background: #e5f5ef; }
.tier.industry { color: #6b7280; background: #f1f2f4; }
.src-text { font-size: 27rpx; }

/* ========== 资源热度 ========== */
.heat-tag { font-size: 24rpx; border-radius: 12rpx; padding: 2rpx 14rpx; white-space: nowrap; }
.heat-hot { color: #78350f; background: #fbbf24; font-weight: 600; }
.heat-warm { color: #475569; background: #eef1f5; }
.heat-cool { color: #6d28d9; background: #f1ecfb; }
.heat-rare { color: #9ca3af; background: #f6f6f6; border: 1rpx dashed #d1d5db; }

/* ========== 时间轴 ========== */
.timeline-section {
  background: #fff; border-bottom: 1rpx solid #e3e8ee;
  padding: 32rpx; margin-bottom: 8rpx;
}
.tl-age { font-size: 26rpx; color: #5b6b7a; font-weight: 400; }
.tl-row { display: flex; gap: 24rpx; padding: 16rpx 0; border-bottom: 1rpx dashed #e3e8ee; }
.tl-row:last-child { border-bottom: none; }
.tl-label { flex: 0 0 320rpx; font-size: 28rpx; font-weight: 600; display: flex; align-items: center; gap: 16rpx; }
.tl-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #0d7377; flex-shrink: 0; }
.tl-dot.d1 { background: #b45309; }
.tl-dot.d2 { background: #8a94a6; }
.tl-dot.d3 { background: #b9c2cf; }
.tl-dot.d4 { background: #d7dde5; }
.tl-dot.d5 { background: #e8ecf1; }
.tl-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tl-chip {
  text-decoration: none; color: #1f2933; background: #eef2f6;
  border-radius: 16rpx; padding: 6rpx 18rpx; font-size: 27rpx;
}
.tl-chip.hot { background: #fde68a; }
.tl-chip.rare { background: #f6f6f6; border: 1rpx dashed #d1d5db; }
.tl-heat { font-size: 21rpx; color: #5b6b7a; margin-left: 8rpx; }
.tl-empty { font-size: 27rpx; color: #5b6b7a; }

/* ========== 页脚 ========== */
.footer {
  background: #fff; border-top: 1rpx solid #e3e8ee;
  padding: 48rpx 32rpx 64rpx; font-size: 28rpx;
}
.disclaimer { color: #b45309; margin-bottom: 24rpx; }
.footer-toggle { color: #0d7377; font-weight: 600; padding: 12rpx 0; }
.guide { margin-top: 16rpx; }
.guide-title { color: #0d7377; font-weight: 700; margin-bottom: 12rpx; }
.guide-intro { font-size: 29rpx; margin-bottom: 16rpx; }
.guide-h { font-size: 25rpx; color: #5b6b7a; margin: 16rpx 0 4rpx; }
.guide-li { font-size: 29rpx; margin-bottom: 6rpx; }
.guide-red { font-size: 29rpx; color: #b91c1c; }
.guide-hr { border-top: 1rpx dashed #e3e8ee; margin: 28rpx 0; }
.version { font-size: 26rpx; margin-top: 28rpx; }

/* ========== 其他 ========== */
.empty { text-align: center; padding: 100rpx 0; color: #5b6b7a; }
.back-top {
  position: fixed; right: 32rpx; bottom: 40rpx; z-index: 40;
  border: 1rpx solid #e3e8ee; background: #fff; color: #0d7377;
  border-radius: 999rpx; padding: 18rpx 28rpx; font-size: 27rpx;
  box-shadow: 0 4rpx 20rpx rgba(15,40,60,.15);
}
